    "All solved puzzles, best times and saved games will be deleted. This cannot be undone.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çözülen tüm bulmacalar, en iyi süreler ve kayıtlı oyunlar silinecek. Bu işlem geri alınamaz."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリアしたパズル、ベストタイム、保存中のゲームがすべて削除されます。この操作は取り消せません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle gelösten Rätsel, Bestzeiten und gespeicherten Spiele werden gelöscht. Das kann nicht rückgängig gemacht werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les grilles résolues, les meilleurs temps et les parties sauvegardées seront supprimés. Cette action est irréversible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se borrarán todos los puzles resueltos, los mejores tiempos y las partidas guardadas. Esta acción no se puede deshacer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os quebra-cabeças resolvidos, melhores tempos e jogos salvos serão apagados. Isso não pode ser desfeito."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "푼 퍼즐, 최고 기록, 저장된 게임이 모두 삭제돼요. 이 작업은 되돌릴 수 없어요."
          }
        }
      }
    },

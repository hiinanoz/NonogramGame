    "Don't break your %lld-day streak! Today's puzzle is waiting.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld günlük serini bozma! Bugünün bulmacası seni bekliyor."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld日連続の記録を途切れさせないで!今日のパズルが待っています。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte deine Serie von %lld Tagen! Das heutige Rätsel wartet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne brisez pas votre série de %lld jours ! La grille du jour vous attend."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡No rompas tu racha de %lld días! El puzle de hoy te espera."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não quebre sua sequência de %lld dias! O desafio de hoje está esperando."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld일 연속 기록을 이어가세요! 오늘의 퍼즐이 기다려요."
          }
        }
      }
    },
    "The cats have a new puzzle ready for you.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kediler senin için yeni bir bulmaca hazırladı."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "猫たちが新しいパズルを用意して待っています。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Katzen haben ein neues Rätsel für dich vorbereitet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les chats vous ont préparé une nouvelle grille."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",

    "Premium refills both to 6 every day at midnight.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Premium'da ikisi de her gece 00:00'da 6'ya tamamlanır."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレミアムなら毎日0時にどちらも6回に戻ります。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit Premium füllen sich beide jeden Tag um Mitternacht auf 6 auf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec Premium, les deux reviennent à 6 chaque jour à minuit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con Premium, ambos vuelven a 6 cada día a medianoche."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com o Premium, os dois voltam a 6 todo dia à meia-noite."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프리미엄은 매일 자정에 둘 다 6개로 채워져요."
          }
        }
      }
    },
    "When they run out, watch a short video for one more. Premium refills them to 6 every day.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitince kısa bir video izleyerek bir hak daha alabilirsin. Premium'da her gün 6'ya tamamlanır."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "なくなったら短い動画を見るともう1回。プレミアムなら毎日6回に戻ります。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn sie aufgebraucht sind, schau ein kurzes Video für einen weiteren. Mit Premium füllen sie sich täglich auf 6 auf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand il n'y en a plus, regarde une courte vidéo pour en obtenir un. Avec Premium, ils reviennent à 6 chaque jour."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando se acaben, mira un video corto para conseguir otro. Con Premium vuelven a 6 cada día."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando acabarem, assista a um vídeo curto para ganhar mais um. Com o Premium, voltam a 6 todo dia."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다 쓰면 짧은 영상을 보고 하나 더 받을 수 있어요. 프리미엄은 매일 6개로 채워져요."
          }
        }
      }
    },

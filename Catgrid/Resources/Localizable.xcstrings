    "A cat slipped through your paws. Keep going with one more paw, or start this level over.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kedi patilerinden kaçtı. Bir pati daha alarak devam et ya da bölüme baştan başla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "猫が肉球からすり抜けちゃった。肉球を1つもらって続けるか、最初からやり直そう。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Katze ist dir entwischt. Mach mit einer weiteren Pfote weiter oder starte das Level neu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un chat t'a filé entre les pattes. Continue avec une patte de plus ou recommence le niveau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un gato se te escapó. Sigue con una patita más o empieza el nivel de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um gato escapou das suas patinhas. Continue com mais uma patinha ou recomece o nível."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고양이가 빠져나갔어요. 발바닥 하나를 더 받아 계속하거나 처음부터 다시 해요."
          }
        }
      }
    },

          }
        }
      }
    },
    "A cat here would leave no room for a cat in the highlighted row.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Buraya kedi konursa vurgulanan satırda kediye yer kalmaz."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここに猫を置くと、強調された行に猫の居場所がなくなります。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Katze hier ließe in der markierten Zeile keinen Platz für eine Katze."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un chat ici ne laisserait aucune place pour un chat dans la ligne en surbrillance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un gato aquí no dejaría sitio para un gato en la fila resaltada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um gato aqui não deixaria lugar para um gato na linha destacada."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기에 고양이를 두면 강조된 행에 고양이 자리가 없어져요."
          }
        }
      }
    },

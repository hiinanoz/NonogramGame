    "No other cat can be in this cat's row, column or color, or right next to it.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kedinin satırında, sütununda, renginde ve hemen yanında başka kedi olamaz."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この猫と同じ行・列・色、そしてすぐ隣には、ほかの猫はいません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der Zeile, Spalte und Farbe dieser Katze und direkt neben ihr kann keine andere Katze sein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun autre chat ne peut être sur la ligne, la colonne ou la couleur de ce chat, ni juste à côté."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No puede haber otro gato en la fila, columna o color de este gato, ni justo a su lado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum outro gato pode estar na linha, coluna ou cor deste gato, nem logo ao lado."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 고양이와 같은 행, 열, 색, 그리고 바로 옆에는 다른 고양이가 없어요."
          }
        }
      }
    },
    "This row has only one spot left for its cat.": {
      "localizations": {
        "tr": {

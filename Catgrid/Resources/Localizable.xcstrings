    },
    "A cat here leads to a dead end: the highlighted row would soon have no room left.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Buraya kedi konursa çıkmaza girilir: vurgulanan satırda kısa sürede yer kalmaz."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここに猫を置くと行き詰まります。強調された行にすぐ居場所がなくなります。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Katze hier führt in eine Sackgasse: In der markierten Zeile wäre bald kein Platz mehr."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un chat ici mène à une impasse : la ligne en surbrillance n'aurait bientôt plus de place."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un gato aquí lleva a un callejón sin salida: la fila resaltada pronto se quedaría sin sitio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um gato aqui leva a um beco sem saída: a linha destacada logo ficaria sem lugar."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기에 고양이를 두면 막혀요. 강조된 행에 곧 자리가 없어져요."
          }
        }
      }
    },

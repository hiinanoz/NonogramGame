    "Hold a square and slide: only that row or column is marked, in a straight line.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kareyi basılı tutup kaydır: yalnızca o satır ya da sütun, düz bir çizgide işaretlenir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マスを押したままスライドすると、その行か列だけがまっすぐ塗られます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte ein Feld gedrückt und wische: Nur diese Zeile oder Spalte wird markiert, in einer geraden Linie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintiens une case et glisse : seule cette ligne ou colonne est marquée, en ligne droite."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén una casilla y desliza: solo se marca esa fila o columna, en línea recta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure um quadrado e deslize: só aquela linha ou coluna é marcada, em linha reta."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "칸을 누른 채 밀면 그 행이나 열만 직선으로 표시돼요."
          }
        }
      }
    },
    "Hold a square and slide in any direction, even diagonally: every square you pass is marked.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kareyi basılı tutup istediğin yöne, çapraz da olsa kaydır: geçtiğin her kare işaretlenir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マスを押したまま、斜めも含めて好きな方向にスライド。通ったマスがすべて塗られます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte ein Feld gedrückt und wische in jede Richtung, auch diagonal: Jedes überstrichene Feld wird markiert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintiens une case et glisse dans n'importe quelle direction, même en diagonale : chaque case traversée est marquée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén una casilla y desliza en cualquier dirección, incluso en diagonal: se marca cada casilla por la que pases."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure um quadrado e deslize em qualquer direção, até na diagonal: cada quadrado por onde passar é marcado."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "칸을 누른 채 대각선을 포함해 어느 방향으로든 밀면 지나가는 모든 칸이 표시돼요."
          }
        }
      }
    }
  },
  "version": "1.0"
}

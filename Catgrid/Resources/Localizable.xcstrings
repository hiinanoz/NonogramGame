          }
        }
      }
    },
    "Today's Daily Puzzle is waiting. Can you get 4 stars?": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günün bulmacası seni bekliyor. 4 yıldız alabilir misin?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日のデイリーパズルが待っています。スター4つを取れるかな?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Tagesrätsel wartet. Schaffst du 4 Sterne?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La grille du jour vous attend. Décrocherez-vous 4 étoiles ?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El puzle diario te espera. ¿Conseguirás 4 estrellas?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Desafio do Dia está esperando. Consegue 4 estrelas?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘의 퍼즐이 기다려요. 별 4개를 받을 수 있을까요?"
          }
        }
      }
    },
    "A few minutes of logic, a lot of cats. Ready to play?": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Biraz mantık, bolca kedi. Oynamaya hazır mısın?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ちょっとのロジックと、たくさんの猫。遊ぶ準備はいい?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein paar Minuten Logik, jede Menge Katzen. Bereit?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelques minutes de logique, beaucoup de chats. Prêt à jouer ?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Unos minutos de lógica y muchos gatos. ¿Listo para jugar?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns minutos de lógica e muitos gatos. Vamos jogar?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠깐의 논리, 가득한 고양이. 플레이할 준비 됐나요?"
          }
        }
      }
    },
    "A new cat card could be one puzzle away!": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni bir kedi kartı belki de bir bulmaca uzağında!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい猫カードまで、あとパズル1つかも!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine neue Katzenkarte ist vielleicht nur ein Rätsel entfernt!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une nouvelle fiche chat n'est peut-être qu'à une grille !"
          }
        },
        "es": {
          "stringUnit": {

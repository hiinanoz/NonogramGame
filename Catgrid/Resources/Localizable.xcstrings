    "Tip: like it calm or lively? Pick Calm or Energetic mode in Settings → Play Style.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İpucu: Sakin mi seversin, hareketli mi? Ayarlar → Oyun Tarzı'ndan Sakin ya da Enerjik modu seç."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヒント:のんびり派?にぎやか派?設定 → プレイスタイルで「おだやか」か「エネルギッシュ」を選べます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipp: Lieber ruhig oder lebhaft? Wähle unter Einstellungen → Spielstil den Modus Ruhig oder Energisch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Astuce : plutôt calme ou animé ? Choisis le mode Calme ou Énergique dans Réglages → Style de jeu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consejo: ¿tranquilo o animado? Elige el modo Tranquilo o Enérgico en Ajustes → Estilo de juego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dica: prefere calmo ou animado? Escolha o modo Calmo ou Energético em Ajustes → Estilo de Jogo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팁: 차분한 게 좋아요, 신나는 게 좋아요? 설정 → 플레이 스타일에서 차분하게나 신나게 모드를 고르세요."
          }
        }
      }
    },
    "Start Over": {
      "localizations": {
        "tr": {

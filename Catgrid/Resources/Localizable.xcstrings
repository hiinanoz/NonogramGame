          }
        }
      }
    },
    "These colors fit in exactly as many rows, so other colors can't have a cat in those rows.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu renkler tam kendi sayıları kadar satıra sığıyor; o satırlarda başka renklerin kedisi olamaz."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの色は色と同じ数の行に収まっています。その行にはほかの色の猫はいません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Farben passen in genauso viele Zeilen, also können andere Farben dort keine Katze haben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces couleurs tiennent dans autant de lignes : les autres couleurs ne peuvent pas avoir de chat dans ces lignes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos colores caben en el mismo número de filas, así que otros colores no pueden tener gato en ellas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas cores cabem no mesmo número de linhas, então outras cores não podem ter gato nelas."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 색들은 색의 수만큼의 행에 딱 들어가요. 그 행에는 다른 색의 고양이가 없어요."
          }
        }
      }
    },
    "These colors fit in exactly as many columns, so other colors can't have a cat in those columns.": {
      "localizations": {
        "tr": {

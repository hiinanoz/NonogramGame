    "The first cat breed opens right away. You can come back to Muffin's School any time from All Levels.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk kedi türü hemen açılır. Muffin'in Okulu'na istediğin zaman Tüm Bölümler'den dönebilirsin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初の猫の品種がすぐに開きます。マフィンの学校には「すべてのレベル」からいつでも戻れます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die erste Katzenrasse wird sofort freigeschaltet. Zu Muffins Schule kannst du jederzeit über „Alle Level“ zurückkehren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La première race de chat s'ouvre tout de suite. Tu peux revenir à l'école de Muffin à tout moment depuis Tous les niveaux."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La primera raza de gato se abre enseguida. Puedes volver a la escuela de Muffin cuando quieras desde Todos los niveles."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A primeira raça de gato abre na hora. Você pode voltar à Escola da Muffin quando quiser em Todos os Níveis."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 번째 고양이 품종이 바로 열려요. 머핀의 학교는 '모든 레벨'에서 언제든 다시 갈 수 있어요."
          }
        }
      }
    },
